#!/bin/bash
# Toggle the browser-compatible T1 camera (it only outputs H.264).
# Install to ~/.local/bin/webcam. In a browser, pick "T1 camera (browser)".
notice() { notify-send -a webcam -t 2500 "$1" "$2" 2>/dev/null; echo "$1"; }

case ${1:-status} in
  on)     systemctl --user start t1-webcam.service && notice "Webcam on" "Pick \"T1 camera (browser)\"" ;;
  off)    systemctl --user stop t1-webcam.service && notice "Webcam off" "" ;;
  toggle) if systemctl --user -q is-active t1-webcam.service; then "$0" off; else "$0" on; fi ;;
  status) systemctl --user is-active t1-webcam.service ;;
  *)      echo "usage: webcam on|off|toggle|status" >&2; exit 2 ;;
esac
